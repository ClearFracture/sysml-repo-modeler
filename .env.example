# Required
# Provider credential used by the OpenCode runtime.
OPENAI_API_KEY=

# Required when running the backend from source. Docker Compose supplies this
# automatically unless you override it.
DATABASE_URL=

# Optional: frontend
# Leave blank for same-origin /api routing.
# VITE_SYSML_BACKEND_URL=

# Optional: app listen settings
# BACKEND_LISTEN_HOST=127.0.0.1
# BACKEND_LISTEN_PORT=8765

# Optional: app-owned workspace paths
# PROJECT_WORKSPACE_ROOT=packages
# SYSML_BACKEND_SCRATCH_PATH=backend-scratch

# Optional: OpenCode integration
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# OPENCODE_HEALTH_PATH=/global/health
# OPENCODE_WORKSPACE_ROOT=/workspace/projects
# OPENCODE_TIMEOUT_SECONDS=600

# Optional: OpenCode server auth
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# Optional: OpenCode model and agent selection
# OPENCODE_PROVIDER_ID=openai
# OPENCODE_MODEL_ID=gpt-5.6-sol
# OPENCODE_AGENT=

# Optional: OpenCode reasoning. Applied by the OpenCode runtime config.
# OPENCODE_REASONING_EFFORT=high
# OPENCODE_REASONING_SUMMARY=auto

# Optional: Jev architecture classification. Without a TypeSafe key, all
# architecture decisions are sent to the configured OpenCode model instead.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0
# JEV_CONFIDENCE_THRESHOLD=0.80
# JEV_TIMEOUT_SECONDS=30

# Optional: OpenCode runtime logging
OPENCODE_LOG_LEVEL=INFO
OPENCODE_PRINT_LOGS=false

# Optional: backend logging
SYSML_BACKEND_LOG_LEVEL=INFO

# Optional: scan telemetry export (vendor-neutral bundles for external eval tools)
TELEMETRY_EXPORT_ROOT=telemetry/scans
