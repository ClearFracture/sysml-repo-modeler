{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "deny"
    },
    "edit": {
      "*": "deny"
    },
    "bash": {
      "*": "deny"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "{env:OPENCODE_REASONING_EFFORT}",
            "reasoningSummary": "{env:OPENCODE_REASONING_SUMMARY}"
          }
        }
      }
    }
  },
  "server": {
    "hostname": "0.0.0.0",
    "port": 4096,
    "mdns": false
  }
}
